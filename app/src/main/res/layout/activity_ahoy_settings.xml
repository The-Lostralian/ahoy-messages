<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ahoy_settings_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.fossify.commons.views.MyAppBarLayout
        android:id="@+id/ahoy_settings_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/ahoy_settings_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/ahoy_server_settings"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </org.fossify.commons.views.MyAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/ahoy_settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/ahoy_settings_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/activity_margin">

            <org.fossify.commons.views.MyMaterialSwitch
                android:id="@+id/ahoy_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/activity_margin"
                android:text="@string/ahoy_enabled" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ahoy_server_url_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ahoy_server_url" />

            <org.fossify.commons.views.MyEditText
                android:id="@+id/ahoy_server_url"
                android:hint="@string/ahoy_server_url_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/activity_margin"
                android:inputType="textUri"
                android:singleLine="true" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ahoy_key_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ahoy_key" />

            <org.fossify.commons.views.MyEditText
                android:id="@+id/ahoy_key"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/activity_margin"
                android:hint="@string/ahoy_key_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:singleLine="true" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ahoy_save_and_test"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/ripple_background"
                android:padding="@dimen/normal_margin"
                android:text="@string/ahoy_save_and_test"
                android:textStyle="bold" />

            <org.fossify.commons.views.MyTextView
                android:id="@+id/ahoy_test_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/normal_margin" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
