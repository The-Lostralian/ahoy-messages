# Copy to .env and fill in. Never commit the real .env.

TZ=Australia/Sydney
# Your name as the model sees it in conversations ("Write <name>'s reply")
OWNER_NAME=Sam

# The key the phone app and server share. Make one with:  openssl rand -base64 32
# Paste the same value into the app (menu > Ahoy server).
SMS_SHARED_KEY=

# When deep reviews may use the GPU, e.g. 22-7 for 10 pm to 7 am. Empty: any time (they always
# pause while the phone is asking for something)
DEEP_REVIEW_HOURS=

# ntfy server and a token that can publish to the ahoy-* topics
NTFY_URL=http://ntfy
NTFY_TOKEN=

# Email triage only: any IMAP account. For most providers use port 993 with IMAP_TLS=ssl
# (with Gmail, an app password). For Proton Mail Bridge on the same Docker network: port 143, IMAP_TLS empty.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_TLS=ssl
IMAP_MAIN_USER=
IMAP_MAIN_PASS=
OWN_DOMAINS=example.com
RADICALE_URL=http://radicale:5232
RADICALE_USER=
RADICALE_PASS=
# Address book paths, comma separated, e.g. /sam/contacts/
RADICALE_CONTACT_BOOKS=
# Optional Uptime Kuma push monitor URL
KUMA_PUSH_URL=
