# Copy to .env and fill in. Never commit the real .env.

TZ=Australia/Sydney
# Your name as the model sees it in conversations ("Write <name>'s reply")
OWNER_NAME=Sam

# The key the phone app and server share. Make one with:  openssl rand -base64 32
# Paste the same value into the app (menu > Ahoy server).
SMS_SHARED_KEY=

# ntfy server and a token that can publish to the ahoy-* topics
NTFY_URL=http://ntfy
NTFY_TOKEN=

# Email triage only
IMAP_HOST=protonmail-bridge
IMAP_MAIN_USER=
IMAP_MAIN_PASS=
OWN_DOMAINS=example.com
RADICALE_URL=http://radicale:5232
RADICALE_USER=
RADICALE_PASS=
# Address book paths, comma separated, e.g. /sam/contacts/
RADICALE_CONTACT_BOOKS=
# Optional Uptime Kuma push monitor URL
KUMA_PUSH_URL=
